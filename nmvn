#!/bin/bash
#
# Launcher for the prebuilt-plugins native images (default: build/nmvn-native).
#
# The image's entry point is nmvn.NmvnLauncher: it takes the BAKED ClassWorld (constructed at
# image build time) and hands it to MavenCling directly — no m2.conf, no classworlds config.


# Which native image to launch: NMVN_BINARY selects a specialized build
# (e.g. NMVN_BINARY=nmvn-spring-4.1.0 from build-nmvn-catalog.sh); default is nmvn-native.
NMVN_BINARY="${NMVN_BINARY:-nmvn-native}"

"$SCRIPT_DIR/$NMVN_BINARY" "$@"
