<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.maven</groupId>
    <artifactId>native</artifactId>
    <version>4.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>launcher</artifactId>
  <packaging>jar</packaging>
  <name>Native Maven Distribution</name>
  <properties>
    <exec.mainClass>nmvn.launcher.NmvnLauncher</exec.mainClass>
    <exec.vmArgs>-Dnone</exec.vmArgs>
    <exec.appArgs />
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>prebuilt-feature</artifactId>
      <version>4.1.0-SNAPSHOT</version>
      <type>jar</type>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>graal-sdk</artifactId>
      <version>25.1.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-embedder</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-compat</artifactId>
    </dependency>

    <dependency>
      <groupId>commons-cli</groupId>
      <artifactId>commons-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.wagon</groupId>
      <artifactId>wagon-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.wagon</groupId>
      <artifactId>wagon-file</artifactId>
    </dependency>

    <!-- CLI -->
    <!-- bridge from Apache Commons Logging (JCL) to SLF4J-->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jcl-over-slf4j</artifactId>
      <version>${slf4jVersion}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- bridge from System.Logger to SLF4J (Platform Logging API, added by JEP 264) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk-platform-logging</artifactId>
      <version>${slf4jVersion}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- bridge from java.util.logging (JUL) to SLF4J -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jul-to-slf4j</artifactId>
      <version>${slf4jVersion}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-connector-basic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-file</artifactId>
    </dependency>
    <!-- HTTP/1.1, lowest priority, Java8+ (still must as some ITs force it) -->
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-wagon</artifactId>
    </dependency>
    <!-- HTTP/1.1, default transport, Java8+ -->
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-transport-apache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-logging</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-reader</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal-jni</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal-ffm</artifactId>
    </dependency>

    <!-- (legacy) DI annotations -->
    <dependency>
      <groupId>javax.inject</groupId>
      <artifactId>javax.inject</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>

    <!-- DI Runtime -->
    <dependency>
      <groupId>org.eclipse.sisu</groupId>
      <artifactId>org.eclipse.sisu.plexus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.sisu</groupId>
      <artifactId>org.eclipse.sisu.inject</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.inject</groupId>
      <artifactId>guice</artifactId>
      <classifier>classes</classifier>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <commandlineArgs>${exec.vmArgs}
            --enable-native-access=ALL-UNNAMED
            -cp %classpath
            nmvn.launcher.NmvnLauncher
            ${exec.appArgs}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Native image build via native-build-tools (migration away from build-scripts/).
         Flag layering: INVARIANT flags ride in the sidecar jar's META-INF native-image.properties;
         PARAMETERIZED flags are literal buildArgs below; the COMPUTED image classpath (dist glob)
         is produced by sanitize-maven-plugin:generate-realm-spec into the @argfile.

         Usage (dist must be built first — the image classpath is the dist's boot/ + lib/):
           mvn -Pnative package -pl native/launcher -am -DskipTests \
             -Dnmvn.plugins="g:a:v,g:a:v,..."          (or -Dnmvn.pluginsFile=path; entries with
                                                        per-plugin |deps keys: whitespace-separated)
         Output: target/${nmvn.imageName}. No plugins → baseline image (JVM fallback serves goals).
         Variants: -Pnative alone = non-crema; -Pnative,crema = Crema (see the crema profile).
         Not yet covered vs the script: PGO, -Os. -->
    <profile>
      <id>native</id>
      <properties>
        <nmvn.plugins />
        <nmvn.pluginsFile />
        <nmvn.imageName>nmvn-native</nmvn.imageName>
        <nmvn.maxRamPercentage>80.0</nmvn.maxRamPercentage>
        <nmvn.mavenHome>${maven.multiModuleProjectDirectory}/apache-maven/target/apache-maven-${project.version}</nmvn.mavenHome>
        <nmvn.configDir>${maven.multiModuleProjectDirectory}/reflection-non-crema</nmvn.configDir>
      </properties>
      <build>
        <plugins>
          <!--
            exposes ${org.apache.maven:prebuilt-feature:jar},
            ${org.apidesign.graalvm:jvm-channel:jar}
            for the sanitize Maven plugin
            below
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>artifact-path-properties</id>
                <goals>
                  <goal>properties</goal>
                </goals>
                <phase>initialize</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven</groupId>
            <artifactId>sanitize-maven-plugin</artifactId>
            <version>${project.version}</version>
            <executions>
              <execution>
                <id>generate-realm-spec</id>
                <goals>
                  <goal>generate-realm-spec</goal>
                </goals>
                <phase>prepare-package</phase>
                <configuration>
                  <mavenHome>${nmvn.mavenHome}</mavenHome>
                  <work>${project.build.directory}/nmvn</work>
                  <argfile>${project.build.directory}/nmvn/native-image.args</argfile>
                  <extraCp>
                    <!-- should use dependencies rather than JARs -->
                    <argument>${org.apache.maven:prebuilt-feature:jar}</argument>
                    <argument>${org.apidesign.graalvm:jvm-channel:jar}</argument>
                  </extraCp>
                  <plugins>
                    <argument>${nmvn.plugins}</argument>
                  </plugins>
                  <pluginsFile>${nmvn.pluginsFile}</pluginsFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <imageName>${nmvn.imageName}</imageName>
              <mainClass>nmvn.launcher.NmvnLauncher</mainClass>
              <!-- ONLY the launcher classes; the dist-exact rest (boot/ + lib/ + sidecar +
                   jvm-channel) rides in the argfile's -cp — the driver merges both. This
                   deliberately bypasses NBT's module-dependency classpath: the dist is the
                   curated ground truth of what runtime Maven ships, and resolving the module
                   graph instead risks silent skew. -->
              <classpath>
                <param>${project.build.outputDirectory}</param>
              </classpath>
              <buildArgs>
                <!-- the argfile holds ONLY the dist-exact image classpath (a build-time glob a
                     pom cannot express); spec.txt/unlinkable.txt exist even when nothing is baked
                     (written empty — PrebuiltPluginRealms reads a blank spec as registry-empty) -->
                <buildArg>@${project.build.directory}/nmvn/native-image.args</buildArg>
                <buildArg>-J-XX:MaxRAMPercentage=${nmvn.maxRamPercentage}</buildArg>
                <buildArg>-Dguice_bytecode_gen_option=DISABLED</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:ConfigurationFileDirectories=${nmvn.configDir}</buildArg>
                <buildArg>-Dnmvn.prebuilt.pluginsFile=${project.build.directory}/nmvn/spec.txt</buildArg>
                <buildArg>-Dnmvn.prebuilt.unlinkable=${project.build.directory}/nmvn/unlinkable.txt</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- MODIFIER profile — always together with native: mvn -Pnative,crema package ...
         Carries only the deltas vs the base native profile; everything shared (prep mojo, NBT
         config, static sidecar flags) comes from -Pnative. Needs a Crema-enabled GraalVM
         (development builds: -H:+RuntimeClassLoading is not in stock releases). -->
    <profile>
      <id>crema</id>
      <properties>
        <!-- crema metadata set: no guice-proxy JSON (Crema defines proxies at run time) and no
             predefined classes (RuntimeClassLoading covers runtime-defined classes) -->
        <nmvn.configDir>${maven.multiModuleProjectDirectory}/reflection-crema</nmvn.configDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>-H:+RuntimeClassLoading</buildArg>
                <buildArg>-H:+GraalJITCompileAtRuntime</buildArg>
                <!-- Crema's runtime class loading serves non-baked plugins natively; delegating
                     them to a HotSpot JVM would bypass the very path this variant exercises.
                     Baked by PrebuiltPluginRealms.JVM_FALLBACK_DEFAULT (build-time init);
                     runtime -Dnmvn.jvm.fallback=true re-enables per invocation. -->
                <buildArg>-Dnmvn.jvm.fallback.default=false</buildArg>
                <!-- Blanket preserves: runtime-loaded plugin classes reflect over core/JDK types
                     on paths no build-time analysis can see, so the crema variant keeps the
                     keep-everything registration the non-crema variant replaced with precise
                     agent metadata (see the size discussion in the non-crema script history). -->
                <buildArg>-H:Preserve=module=java.base</buildArg>
                <buildArg>-H:Preserve=module=java.logging</buildArg>
                <buildArg>-H:Preserve=module=java.xml</buildArg>
                <buildArg>-H:Preserve=module=java.desktop</buildArg>
                <buildArg>-H:Preserve=module=java.compiler</buildArg>
                <buildArg>-H:Preserve=module=jdk.compiler</buildArg>
                <buildArg>-H:Preserve=module=jdk.unsupported</buildArg>
                <buildArg>-H:Preserve=package=org.apache.maven.*</buildArg>
                <buildArg>-H:Preserve=package=com.ctc.wstx.*</buildArg>
                <buildArg>-H:Preserve=package=org.apache.commons.logging.impl.*</buildArg>
                <buildArg>-H:Preserve=package=org.eclipse.aether.*</buildArg>
                <buildArg>-H:Preserve=package=org.slf4j.*</buildArg>
                <buildArg>-H:Preserve=package=org.codehaus.plexus.*</buildArg>
                <buildArg>-H:Preserve=package=nmvn.*</buildArg>
                <buildArg>-H:Preserve=package=com.google.inject.*</buildArg>
                <buildArg>-H:Preserve=package=com.google.common.*</buildArg>
                <buildArg>-H:Preserve=package=org.eclipse.sisu.*</buildArg>
                <buildArg>-H:Preserve=package=org.sonatype.*</buildArg>
                <buildArg>-H:Preserve=package=org.fusesource.*</buildArg>
                <buildArg>-H:Preserve=package=org.jline.*</buildArg>
                <buildArg>-H:Preserve=package=javax.inject.*</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
