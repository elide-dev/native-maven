<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.maven</groupId>
    <artifactId>native</artifactId>
    <version>4.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>prebuilt-feature</artifactId>
  <packaging>jar</packaging>
  <properties>
    <nmvn.hotspotMain.jar>${project.basedir}/../hotspot-main/target/nmvn-hotspot-main-${project.version}.jar</nmvn.hotspotMain.jar>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>graal-sdk</artifactId>
      <version>25.1.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apidesign.graalvm</groupId>
      <artifactId>jvm-interop</artifactId>
      <version>${jvmChannelVersion}</version>
    </dependency>
    <dependency>
      <groupId>com.google.inject</groupId>
      <artifactId>guice</artifactId>
      <classifier>classes</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.sisu</groupId>
      <artifactId>org.eclipse.sisu.inject</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- provided: `-am` reactor order only. Not packaged (jar plugin skips provided);
         image -cp is sidecar jar + jvm-channel + dist, so these classes stay off it. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>nmvn-hotspot-main</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Sibling target/, not ~/.m2: a missing jar fails instead of baking a stale wrapper. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-hotspot-main-jar</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <target>
                <fail message="Missing ${nmvn.hotspotMain.jar} — build native/hotspot-main first (use -am).">
                  <condition>
                    <not>
                      <available file="${nmvn.hotspotMain.jar}" />
                    </not>
                  </condition>
                </fail>
                <mkdir dir="${project.build.outputDirectory}/nmvn/hotspot" />
                <copy file="${nmvn.hotspotMain.jar}" overwrite="true" tofile="${project.build.outputDirectory}/nmvn/hotspot/nmvn-hotspot-main.jar" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
